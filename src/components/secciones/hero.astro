---
// Hero de lanzamiento: foto a sangre del producto a casi toda la pantalla con un velo negro, titular en
// mayúsculas muy pesadas, sello redondo con el precio (`precio`, `precio_nota`), dos botones, el nombre del
// producto (`producto`; si falta, el del negocio) gigante y hueco abajo, y una cinta a todo el ancho en el
// color de marca con los puntos fuertes (`items[].titulo`) que se desliza. Si abre la página, sube por debajo
// de la cabecera (que se queda transparente encima). Sin precio no hay sello; sin items no hay cinta.
import { seccion, site, campo } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const producto = campo(s?.producto) || site.nombre;
const precio = campo(s?.precio);
const nota = campo(s?.precio_nota);
const cinta = s ? s.items.map((i) => campo(i?.titulo)).filter(Boolean) : [];
// El nombre gigante ocupa casi todo el ancho sea cual sea su longitud.
const letras = Math.max(producto.length, 4);
const tamGigante = `font-size:min(28rem, ${(165 / letras).toFixed(2)}vw)`;
---

{
  s && (
    <section id={id} class:list={['hero-lanzamiento banda-negra relative isolate overflow-hidden', { 'hero-lanzamiento--primera': primera }]}>
      <div class="relative flex min-h-[92svh] flex-col">
        <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} class="absolute inset-0 -z-10 h-full w-full object-cover" />
        <div class="hero-velo absolute inset-0 -z-10" aria-hidden="true" />
        <div class="contenedor-ancho relative grid flex-1 content-center gap-10 pt-28 pb-8 md:pt-36 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
          <div class="max-w-[54rem]">
            {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
            <h1 class="mt-5 text-[clamp(2.6rem,7vw,6.75rem)]">{s.titulo || producto}</h1>
            {s.texto && <p class="mt-6 max-w-[36rem] text-lg opacity-85 md:text-xl">{s.texto}</p>}
            {(s.cta?.url || s.cta_secundario?.url) && (
              <div class="mt-9 flex flex-wrap gap-3">
                {s.cta?.url && <a class="btn" href={s.cta.url}>{s.cta.texto}<span class="btn-flecha" aria-hidden="true">→</span></a>}
                {s.cta_secundario?.url && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
              </div>
            )}
          </div>
          {precio && (
            <p class="sello-precio banda-color">
              <span class="sello-cifra">{precio}</span>
              {nota && <span class="sello-nota">{nota}</span>}
            </p>
          )}
        </div>
        <p class="producto-gigante hueco" style={tamGigante} aria-hidden="true">{producto}</p>
      </div>
      {cinta.length > 0 && (
        <div class="cinta banda-color">
          <ul class="cinta-pista">
            {cinta.map((t) => <li>{t}</li>)}
            {cinta.map((t) => <li aria-hidden="true">{t}</li>)}
            {cinta.map((t) => <li aria-hidden="true">{t}</li>)}
          </ul>
        </div>
      )}
    </section>
  )
}

<style>
  .hero-lanzamiento--primera { margin-top: calc(-1 * var(--alto-cabecera)); }
  .hero-velo {
    background:
      linear-gradient(to top, var(--c-fondo) 0%, color-mix(in srgb, var(--c-fondo) 55%, transparent) 30%, transparent 60%),
      linear-gradient(100deg, color-mix(in srgb, var(--c-fondo) 88%, transparent) 0%, color-mix(in srgb, var(--c-fondo) 55%, transparent) 45%, transparent 75%);
  }
  .sello-precio {
    display: grid; place-content: center; justify-items: center; gap: .35rem; text-align: center;
    width: 9.5rem; height: 9.5rem; border-radius: 50%; padding: 1rem; transform: rotate(-9deg);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c-primario) 35%, transparent);
  }
  @media (min-width: 1024px) { .sello-precio { width: 12.5rem; height: 12.5rem; margin-right: 2rem; } }
  .sello-cifra { font-family: var(--fuente-titulos); font-weight: 900; font-size: clamp(2.1rem, 4vw, 3.1rem); line-height: .9; letter-spacing: -0.02em; }
  .sello-nota { font-family: var(--fuente-mono); font-size: .66rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; line-height: 1.3; max-width: 9rem; }
  .producto-gigante {
    font-family: var(--fuente-titulos); font-weight: 900; text-transform: uppercase; white-space: nowrap;
    line-height: .78; letter-spacing: -0.03em; padding-inline: 1rem; margin-bottom: -.06em;
    -webkit-text-stroke-color: color-mix(in srgb, var(--c-texto) 70%, transparent);
  }
  @media (min-width: 768px) { .producto-gigante { padding-inline: 2.5rem; -webkit-text-stroke-width: 3px; } }
  .cinta { overflow: hidden; border-block: 2px solid var(--c-fondo); }
  .cinta-pista { display: flex; width: max-content; animation: deslizar 38s linear infinite; }
  .cinta-pista li {
    display: inline-flex; align-items: center; gap: 1.5rem; padding: 1rem 0 1rem 1.5rem; white-space: nowrap;
    font-family: var(--fuente-titulos); font-weight: 900; text-transform: uppercase; font-size: clamp(1.05rem, 2vw, 1.5rem); letter-spacing: .01em;
  }
  .cinta-pista li::after { content: ""; width: .7rem; height: .7rem; background: currentColor; transform: rotate(45deg); }
  @keyframes deslizar { to { transform: translateX(-33.333%); } }
</style>
