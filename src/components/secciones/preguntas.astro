---
// Preguntas frecuentes: banda negra; titular enorme fijo a la izquierda en escritorio y, a la derecha, el
// acordeón nativo <details> en filas separadas por líneas, con número y un «+» en un cuadro del color de marca.
// Sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta.
// También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={Astro.props.id} class="banda-negra">
      <div class="contenedor-ancho seccion grid gap-12 lg:grid-cols-12">
        <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          {s.texto && <p class="titular-texto">{s.texto}</p>}
        </div>
        <div class="lg:col-span-7">
          {preguntas.map((p, i) => (
            <details class="faq" open={i === 0}>
              <summary class="grid grid-cols-[auto_1fr_auto] items-center gap-4 py-6 md:gap-6 md:py-7">
                <span class="mono text-sm font-bold opacity-60">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true"><span>+</span></span>
              </summary>
              {p.respuesta && <p class="max-w-2xl pb-8 pl-9 text-lg opacity-80 md:pl-12">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq { border-top: 1px solid var(--linea); }
  .faq:last-child { border-bottom: 1px solid var(--linea); }
  .faq-pregunta { font-family: var(--fuente-titulos); font-weight: 900; text-transform: uppercase; font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.08; }
  .faq-signo { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; background: var(--c-primario); color: var(--c-sobre-primario); font-size: 1.6rem; font-weight: 800; }
  .faq-signo span { display: block; line-height: 1; transition: transform .2s ease; }
  .faq[open] .faq-signo span { transform: rotate(45deg); }
  .faq summary:hover .faq-pregunta { color: var(--c-primario); }
</style>
