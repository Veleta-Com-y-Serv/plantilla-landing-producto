---
// Apartado de texto genérico (apartados nuevos que pide el cliente: `tipo: texto`). Banda hueso.
// Con foto: fila 50/50 a sangre, la foto toca el borde izquierdo y el texto va a la derecha.
// Sin foto: titular enorme a la izquierda y párrafos a la derecha, a todo el ancho del contenedor.
// Campos: antetitulo, titulo, texto (párrafos separados por una línea en blanco), imagen, items[] (titulo, texto, icono) y cta.
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((i) => i && i.titulo) : [];
---

{
  s && (
    <section id={Astro.props.id} class="banda-hueso">
      <div class:list={['grid', { 'lg:grid-cols-2': s.imagen }]}>
        {s.imagen && <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} class="aspect-[4/3] w-full object-cover lg:aspect-auto lg:h-full lg:min-h-[36rem]" />}
        <div class:list={['seccion', s.imagen ? 'medio-dcha' : 'contenedor-ancho grid gap-10 lg:grid-cols-12']}>
          <div class:list={{ 'lg:col-span-6': !s.imagen }}>
            {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
            {s.titulo && <h2 class="titulo-medio mt-4">{s.titulo}</h2>}
          </div>
          <div class:list={{ 'lg:col-span-6 lg:pt-10': !s.imagen }}>
            <div class="mt-6 space-y-4 text-lg opacity-85">
              {parrafos(s.texto).map((p) => <p>{p}</p>)}
            </div>
            {items.length > 0 && (
              <ul class="mt-8">
                {items.map((it) => (
                  <li class="flex gap-4 border-t border-current/20 py-4">
                    <Icono nombre={it.icono} class="mt-1 shrink-0" tam={22} />
                    <div>
                      <p class="font-bold">{it.titulo}</p>
                      {it.texto && <p class="opacity-75">{it.texto}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            )}
            {s.cta?.url && <a class="btn mt-8" href={s.cta.url}>{s.cta.texto}<span class="btn-flecha" aria-hidden="true">→</span></a>}
          </div>
        </div>
      </div>
    </section>
  )
}
