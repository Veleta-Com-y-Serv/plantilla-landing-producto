---
// Layout base de la plantilla. NO TOCAR salvo orden explícita de diseño.
// Pone el idioma, las metas SEO (src/lib/seo.ts: canónica, og, robots y JSON-LD), los colores de site.yaml como variables CSS, la cabecera y el pie.
// Además calcula la letra que va sobre el primario y sobre el acento (--c-sobre-primario, --c-sobre-acento):
// de los dos colores del cliente (fondo y texto), el que más contraste da. Así la banda de color se lee con cualquier paleta.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { altHero, canonica, imagenCompartir, imagenCompartirDe, indexable, jsonLdNegocio, jsonLdPreguntas, jsonSeguro, urlBase } from '../lib/seo';

interface Props { titulo?: string; descripcion?: string; imagen?: string; ld?: (Record<string, unknown> | null)[] }
const { titulo, descripcion, imagen: foto, ld: ldPagina = [] } = Astro.props;

const VARIANTE_CABECERA = 'lanzamiento';
const VARIANTE_PIE = 'lanzamiento';

const title = titulo ? `${titulo} · ${site.nombre}` : site.seo.titulo;
const description = descripcion ?? site.seo.descripcion;
const c = site.colores;

/** Luminancia relativa de un color #rgb o #rrggbb (WCAG); null si no se entiende. */
function luminancia(color: string): number | null {
  let h = String(color).trim().replace(/^#/, '');
  if (/^[0-9a-f]{3}$/i.test(h)) h = h.split('').map((x) => x + x).join('');
  if (!/^[0-9a-f]{6}$/i.test(h)) return null;
  const canal = (i: number) => {
    const v = parseInt(h.slice(i, i + 2), 16) / 255;
    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * canal(0) + 0.7152 * canal(2) + 0.0722 * canal(4);
}
const contraste = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
/** De fondo y texto, el que mejor se lee sobre `color`; si alguno no se entiende, casi negro o blanco. */
function letraSobre(color: string): string {
  const l = luminancia(color);
  if (l == null) return c.texto;
  const lf = luminancia(c.fondo), lt = luminancia(c.texto);
  if (lf == null || lt == null) return l > 0.4 ? '#0b0b0b' : '#ffffff';
  return contraste(l, lf) >= contraste(l, lt) ? c.fondo : c.texto;
}

const variables = `--c-primario:${c.primario};--c-acento:${c.acento};--c-fondo:${c.fondo};--c-texto:${c.texto};--c-sobre-primario:${letraSobre(c.primario)};--c-sobre-acento:${letraSobre(c.acento)}`;
// SEO de base (src/lib/seo.ts): dirección canónica (seo.url o SITE_URL), foto para compartir, indexación y JSON-LD.
const base = urlBase(Astro.site);
const canonical = canonica(Astro.url.pathname, base);
const imagen = foto ? imagenCompartirDe(foto, base) : imagenCompartir(base);
const ld = jsonLdNegocio(base, 'LocalBusiness');
const ldPreguntas = Astro.url.pathname === '/' ? jsonLdPreguntas() : null;
---

<!doctype html>
<html lang="es-ES" style={variables}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={c.fondo} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!indexable() && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.nombre} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imagen && <meta property="og:image" content={imagen} />}
    {imagen && <meta property="og:image:alt" content={foto && titulo ? titulo : altHero()} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={jsonSeguro(ld)} />
    {ldPreguntas && <script type="application/ld+json" set:html={jsonSeguro(ldPreguntas)} />}
    {ldPagina.filter(Boolean).map((o) => <script type="application/ld+json" set:html={jsonSeguro(o)} />)}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header variante={VARIANTE_CABECERA} cta={site.boton_cabecera} />
    <main id="contenido">
      <slot />
    </main>
    <Footer variante={VARIANTE_PIE} />
  </body>
</html>
